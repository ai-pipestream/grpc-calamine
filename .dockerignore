# Everything the image build does not need. Keeping the context small also
# keeps a stale host `target/` (gigabytes, and built against the wrong libc)
# out of the builder.
#
# demos/sample-data stays: the test suite in the build stage reads its
# workbook fixtures. The demos' own build artifacts do not.
target
bench/target
demos/node-client/node_modules
demos/python-client/.venv
demos/python-client/gen
demos/java-client/target
.git
.github
AGENTS.md
.gitignore
.dockerignore
Dockerfile
