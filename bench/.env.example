# Machine-specific bench settings. Copy this file to .env (gitignored) and
# edit. Real environment variables always win over .env values, so
# `BENCH_ADDR=... cargo run` still works as documented in the README.
# Addresses below are dummies from documentation ranges.

# Workbook used when none is given on the command line.
#BENCH_WORKBOOK=/path/to/workbook.xlsx

# Remote server for the over-a-network runs; arms 0-2 stay local.
#BENCH_ADDR=192.0.2.10:50055

# Client HTTP/2 stream and connection window in bytes; 0 keeps hyper's
# 1 MiB default so the two can be compared.
#WINDOW_BYTES=52428800

# max_rows_per_message for arm 3: 0 = server default, 1 = row per message.
#BATCH=0

# grpc-encoding requested for the row stream: none, gzip or zstd.
#BENCH_COMPRESSION=none

# 1 opts arm 3 into the contract's use_string_table dictionary mode.
#BENCH_DICT=0
